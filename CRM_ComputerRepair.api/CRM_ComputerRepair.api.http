@CRM_ComputerRepair.api_HostAddress = https://localhost:7042

### ═══════════════════════════════════════════════════════════
### 1. Get companies
GET {{CRM_ComputerRepair.api_HostAddress}}/companies
Accept: application/json

### ═══════════════════════════════════════════════════════════
### 2. Get company databases
GET {{CRM_ComputerRepair.api_HostAddress}}/company-databases
Accept: application/json

### ═══════════════════════════════════════════════════════════
### 3. Test tenant connection
GET {{CRM_ComputerRepair.api_HostAddress}}/test-tenant/1
Accept: application/json

### ═══════════════════════════════════════════════════════════
### 4. Create Customer (run FIRST)
POST {{CRM_ComputerRepair.api_HostAddress}}/tenant/1/customers
Content-Type: application/json

{
  "firstName": "Juan",
  "lastName": "Dela Cruz",
  "email": "juan@example.com",
  "phone": "09171234567",
  "address": "Davao City",
  "isActive": true,
  "createdAt": "2026-09-13T09:00:00"
}

### ═══════════════════════════════════════════════════════════
### 5. Get customers (verify CustomerId = 1 exists)
GET {{CRM_ComputerRepair.api_HostAddress}}/tenant/1/customers
Accept: application/json

### ═══════════════════════════════════════════════════════════
### 6. Create Supplier (run SECOND)
POST {{CRM_ComputerRepair.api_HostAddress}}/tenant/1/suppliers
Content-Type: application/json

{
  "supplierCode": "SUP001",
  "supplierName": "Davao Tech Supply",
  "contactPerson": "Carlos Reyes",
  "contactNumber": "09175551234",
  "emailAddress": "sales@davaotechsupply.com",
  "address": "Davao City",
  "notes": "Payment terms: 30 days",
  "isActive": true,
  "createdAt": "2026-09-13T09:00:00"
}

### ═══════════════════════════════════════════════════════════
### 7. Get suppliers (verify SupplierId = 1 exists)
GET {{CRM_ComputerRepair.api_HostAddress}}/tenant/1/suppliers
Accept: application/json

### ═══════════════════════════════════════════════════════════
### 8. Create Part (run THIRD — uses SupplierId = 1)
POST {{CRM_ComputerRepair.api_HostAddress}}/tenant/1/parts
Content-Type: application/json

{
  "partCode": "SCR-LP-001",
  "partName": "Laptop Screen 15.6 inch",
  "category": "Screen",
  "manufacturer": "Dell",
  "model": "Inspiron 15",
  "unitCost": 3000.00,
  "unitPrice": 4500.00,
  "quantityOnHand": 10,
  "reorderLevel": 2,
  "supplierId": 1,
  "isActive": true,
  "createdAt": "2026-09-13T09:15:00"
}

### ═══════════════════════════════════════════════════════════
### 9. Get parts (verify PartId = 1 exists)
GET {{CRM_ComputerRepair.api_HostAddress}}/tenant/1/parts
Accept: application/json

### ═══════════════════════════════════════════════════════════
### 10. Create Repair Request (run FOURTH — uses CustomerId = 1)
POST {{CRM_ComputerRepair.api_HostAddress}}/tenant/1/repair-requests
Content-Type: application/json

{
  "customerId": 1,
  "deviceModel": "Dell Inspiron 15",
  "serialNumber": "SN-TEST-001",
  "issueDescription": "Screen is cracked, needs replacement",
  "status": 0,
  "priority": 1,
  "requestDate": "2026-09-13T10:00:00",
  "estimatedCost": 5000.00
}

### ═══════════════════════════════════════════════════════════
### 11. Get repair requests
GET {{CRM_ComputerRepair.api_HostAddress}}/tenant/1/repair-requests
Accept: application/json

### ═══════════════════════════════════════════════════════════
### 12. Add Part to Repair (run LAST)
POST {{CRM_ComputerRepair.api_HostAddress}}/tenant/1/repair-requests/1/parts
Content-Type: application/json

{
  "partId": 1,
  "quantityUsed": 1
}

### ═══════════════════════════════════════════════════════════
### 13. Get repair parts
GET {{CRM_ComputerRepair.api_HostAddress}}/tenant/1/repair-requests/1/parts
Accept: application/json