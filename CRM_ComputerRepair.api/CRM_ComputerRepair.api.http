@CRM_ComputerRepair.api_HostAddress = https://localhost:7042

### ═══════════════════════════════════════════════════════════
### MASTER DB
### ═══════════════════════════════════════════════════════════

### 1. Get companies
GET {{CRM_ComputerRepair.api_HostAddress}}/companies
Accept: application/json

### 2. Get company databases
GET {{CRM_ComputerRepair.api_HostAddress}}/company-databases
Accept: application/json

### ═══════════════════════════════════════════════════════════
### CUSTOMER CRUD — Company 1 (TenantA)
### ═══════════════════════════════════════════════════════════

### 3. Test tenant 1
GET {{CRM_ComputerRepair.api_HostAddress}}/test-tenant/1
Accept: application/json

### 4. CREATE Customer (Pedro Penduko)
POST {{CRM_ComputerRepair.api_HostAddress}}/tenant/1/customers
Content-Type: application/json

{
  "firstName": "Pedro",
  "lastName": "Penduko",
  "email": "pedro@example.com",
  "phone": "09171112222",
  "address": "Manila"
}

### 5. READ all active customers (Company 1)
GET {{CRM_ComputerRepair.api_HostAddress}}/tenant/1/customers
Accept: application/json

### 6. READ one customer (Company 1, id 1)
GET {{CRM_ComputerRepair.api_HostAddress}}/tenant/1/customers/1
Accept: application/json

### 7. UPDATE customer 1 (Company 1)
PUT {{CRM_ComputerRepair.api_HostAddress}}/tenant/1/customers/1
Content-Type: application/json

{
  "firstName": "Pedro",
  "lastName": "Penduko Jr.",
  "email": "pedro.jr@example.com",
  "phone": "09173334444",
  "address": "Quezon City"
}

### 8. ARCHIVE customer 1 (soft delete)
DELETE {{CRM_ComputerRepair.api_HostAddress}}/tenant/1/customers/1

### 9. READ all (archived hidden)
GET {{CRM_ComputerRepair.api_HostAddress}}/tenant/1/customers
Accept: application/json

### 10. READ all INCLUDING archived
GET {{CRM_ComputerRepair.api_HostAddress}}/tenant/1/customers?includeArchived=true
Accept: application/json

### 11. RESTORE customer 1
POST {{CRM_ComputerRepair.api_HostAddress}}/tenant/1/customers/1/restore

### 12. READ all (restored shows again)
GET {{CRM_ComputerRepair.api_HostAddress}}/tenant/1/customers
Accept: application/json

